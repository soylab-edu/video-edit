{
  "name": "moa-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:local": "node scripts/start-local.mjs",
    "dev": "concurrently -k -n api,web \"node --use-env-proxy --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node --use-env-proxy server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/create-demo.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:windows": "node tests/windows-workflow.mjs",
    "format": "prettier --write src server tests scripts/*.mjs *.json *.ts",
    "invite": "node scripts/invite.mjs",
    "preview:public": "node --use-env-proxy --use-system-ca scripts/preview.mjs"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.160.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
